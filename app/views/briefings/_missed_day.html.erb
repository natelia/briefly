<div class="mb-6 rounded-2xl bg-accent-soft px-5 py-4">
  <p class="text-[0.9375rem] leading-[1.5] text-ink-secondary">You skipped <%= briefing.date.strftime("%A") %>. Nothing stacked — one thing mattered: <%= link_to briefing.stories.unread.first.title, briefing_path(date: briefing.date), class: "font-semibold text-ink-primary underline decoration-accent decoration-1 underline-offset-4" %>.</p>
  <p class="mt-2.5">
    <%= link_to "catch up on #{briefing.date.strftime("%A")}", briefing_path(date: briefing.date), class: "mark-btn no-underline" %>
  </p>
</div>
