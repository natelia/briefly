<div id="<%= dom_id(briefing, :progress) %>" class="mb-8">
  <div class="h-[7px] w-full overflow-hidden rounded-full bg-bg-tertiary">
    <div class="rule-fill h-full rounded-full bg-accent" data-controller="progress" data-fill="<%= briefing.read_fraction.to_f %>" style="--fill: <%= (local_assigns[:from] || 0).to_f %>"></div>
  </div>
  <% if briefing.read_fraction == Rational(1) && briefing.stories.any? %>
    <p class="mt-2 text-[0.8125rem] font-medium text-ink-secondary">All <%= briefing.stories.count %> read — you're caught up, that's the whole internet for today.</p>
  <% else %>
    <p class="mt-2 text-[0.8125rem] text-ink-tertiary"><span class="font-medium text-ink-secondary"><%= briefing.stories.read.count %> of <%= briefing.stories.count %> read</span> — this bar fills as you read. When it's full, you're caught up, that's the whole internet.</p>
  <% end %>
</div>
