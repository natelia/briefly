<% hue = section_hue(story) %>
<article class="mb-4 rounded-2xl border border-transparent px-5 py-4 <%= "read-card" if story.read? %>" id="<%= dom_id(story) %>" style="background: var(--color-<%= hue %>-soft);">
  <h3 class="text-[1.0625rem]">
    <%= link_to story.title, story.url, target: "_blank", rel: "noopener", class: "font-semibold underline decoration-1 underline-offset-4", style: "text-decoration-color: var(--color-#{hue});" %>
  </h3>
  <p class="mb-2.5 mt-1.5 font-mono text-xs text-ink-tertiary"><%= story.source_name %></p>
  <p class="text-[1.0625rem] leading-[1.6] <%= story.read? ? "text-ink-tertiary" : "text-ink-secondary" %>"><%= story.summary %></p>
  <% if story.stretch? %>
    <p class="mt-4 rounded-xl border-l-4 bg-bg-primary/70 px-4 py-3.5 text-[0.9375rem] leading-[1.6] text-ink-secondary" style="border-left-color: var(--color-<%= hue %>);">
      <strong class="font-semibold text-ink-primary">Why this matters for you:</strong> <%= story.why_it_matters %>
    </p>
  <% end %>
  <div class="mt-5 flex flex-wrap items-center justify-between gap-3">
    <%= link_to "source", story.url, target: "_blank", rel: "noopener", class: "text-[0.8125rem] text-ink-tertiary underline decoration-edge decoration-1 underline-offset-4" %>
    <% if story.read? %>
      <span class="flex items-center gap-4">
        <span class="inline-flex h-7 items-center rounded-full px-3 text-[0.8125rem] font-medium" style="background: var(--color-<%= hue %>-soft); color: var(--color-<%= hue %>-ink); box-shadow: inset 0 0 0 1px var(--color-<%= hue %>);">read</span>
        <%= button_to "Mark unread", mark_unread_story_path(story), method: :patch, data: { turbo_stream: true }, class: "cursor-pointer border-0 bg-transparent p-0 text-[0.8125rem] font-medium text-ink-tertiary underline decoration-edge decoration-1 underline-offset-4 hover:text-ink-secondary" %>
      </span>
    <% else %>
      <%= button_to "Mark read", mark_read_story_path(story), method: :patch, data: { turbo_stream: true }, class: "mark-btn", style: "--bh: var(--color-#{hue}); --bhi: var(--color-#{hue}-ink);" %>
    <% end %>
  </div>
</article>
