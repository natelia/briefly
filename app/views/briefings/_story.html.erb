<article class="mb-3 rounded-xl border border-edge p-4">
  <h3 class="text-base leading-snug font-bold">
    <%= link_to story.title, story.url, target: "_blank", rel: "noopener", class: "hover:underline" %>
  </h3>
  <p class="mt-1 mb-2 text-xs text-ink-tertiary"><%= story.source_name %></p>
  <p class="text-sm text-ink-primary opacity-85"><%= story.summary %></p>
  <% if story.stretch? %>
    <p class="mt-3 rounded-md border-l-4 <%= bar %> bg-bg-tertiary px-3 py-2 text-sm text-ink-secondary">
      <strong class="text-ink-primary">Why this matters for you:</strong> <%= story.why_it_matters %>
    </p>
  <% end %>
  <p class="mt-3 text-xs">
    <%= link_to "source →", story.url, target: "_blank", rel: "noopener", class: "text-ink-tertiary hover:underline" %>
  </p>
</article>
