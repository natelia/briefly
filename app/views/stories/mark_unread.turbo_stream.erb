<%= turbo_stream.replace @story, partial: "briefings/story", locals: { story: @story } %>
<% total = @story.briefing.stories.count %>
<% from = Rational(@story.briefing.stories.read.count + 1, total) %>
<%= turbo_stream.replace dom_id(@story.briefing, :progress), partial: "briefings/progress", locals: { briefing: @story.briefing, from: from } %>
